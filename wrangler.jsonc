{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zynlo-crm",
  "main": "@tanstack/react-start/server-entry",
  // 2026-08-04+ enables nodejs_compat by default; the flag is set explicitly
  // so WebCrypto/jose and process.env keep working if the date is rolled back.
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Static assets are uploaded from the Vite client build. base_path mounts
  // that directory at /CRM so a zone route of zynlo.lk/CRM* can reach them.
  // run_worker_first sends asset requests through the Worker so the Access
  // JWT is checked before a file is returned. Do not add routes here — the
  // zynlo.lk/CRM* route is attached separately.
  "assets": {
    "base_path": "/CRM",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "zynlo.cloudflareaccess.com",
    "ACCESS_AUD": "bef128d05837d7d49acd8bb11f65e07633813d13dd6d5239d9773b23a743788c",
    "ADMIN_EMAILS": "susika.vs@gmail.com,edirisinghayashodha@gmail.com"
  }
  // Secret (not a var — never commit it):
  //   npx wrangler secret put FIREBASE_SERVICE_ACCOUNT_JSON
  // Value is the full Firebase service-account JSON string.
  //
  // Local UI without Access: the check is skipped only when ACCESS_TEAM_DOMAIN
  // and ACCESS_AUD are unset AND the host is local dev. Set DEV_AGENT_EMAIL to
  // one of the allowlisted addresses (shell env or .dev.vars). Do not set
  // DEV_AGENT_EMAIL in this file — it would ship to production.
}
